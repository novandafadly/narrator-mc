# Nara (Amica) - salin file ini ke .env.local lalu isi key sendiri.
# .env.local TIDAK boleh di-commit (sudah ada di .gitignore).
# Catatan: variabel NEXT_PUBLIC_* ikut tertanam di kode browser. Hanya pakai di localhost.

# Wajib: kode Amica membangun URL dari variabel ini saat start.
NEXT_PUBLIC_DEVELOPMENT_BASE_URL=http://localhost:3000

# --- Identitas dan tampilan (tahap 1) ---
NEXT_PUBLIC_NAME=Nara
NEXT_PUBLIC_LANGUAGE=en
NEXT_PUBLIC_SHOW_INTRODUCTION=false
NEXT_PUBLIC_SHOW_ADD_TO_HOMESCREEN=false
NEXT_PUBLIC_AMICA_LIFE_ENABLED=false
NEXT_PUBLIC_VRM_HASH=/vrm/AvatarSample_A.vrm
NEXT_PUBLIC_BG_COLOR="#1c2a3a"

# Placeholder kosong-makna: modul "external API" Amica (X/Telegram, tidak dipakai)
# melempar error saat start jika variabel ini tidak ada. Jangan isi dengan key asli.
X_API_KEY="unused"
X_API_SECRET="unused"
X_ACCESS_TOKEN="unused"
X_ACCESS_SECRET="unused"
X_BEARER_TOKEN="unused"
TELEGRAM_BOT_TOKEN="unused"
TELEGRAM_CHAT_ID="unused"

# --- Video Avatar Fotorealistis (Utama) + Cadangan 3D VRM ---
# Jika URL server MuseTalk v1.5 + Edge TTS diisi, Video Avatar aktif otomatis.
# URL juga bisa diubah langsung dari panel operator kanan atas tanpa rebuild.
# NEXT_PUBLIC_VIDEO_AVATAR_ENABLED=true
# NEXT_PUBLIC_VIDEO_AVATAR_URL=https://xxxx.trycloudflare.com
NEXT_PUBLIC_VIDEO_AVATAR_IDLE_URL=/avatar/nara_idle.mp4
NEXT_PUBLIC_VIDEO_AVATAR_POSTER_URL=/avatar/nara_poster.jpg
NEXT_PUBLIC_VIDEO_AVATAR_VOICE=id-ID-GadisNeural

# --- Backend ---
#
# Tahap 2 (LLM Gemini lewat endpoint kompatibel OpenAI): ganti baris di bawah
# menjadi chatgpt dan isi variabel di bagian "Tahap 2" (terutama APIKEY dan MODEL).
# Jalankan `npm run nara:models` untuk melihat nama model yang tersedia.
NEXT_PUBLIC_CHATBOT_BACKEND=echo
# TTS cadangan untuk mode 3D VRM: edge_tts (id-ID-GadisNeural via /tts),
# openai_tts (endpoint lokal seperti http://localhost:5050), browser_tts, atau none.
NEXT_PUBLIC_TTS_BACKEND=edge_tts
# STT Bahasa Indonesia: browser_speech (Web Speech API id-ID), whisper_openai (/stt Groq Whisper), atau none.
NEXT_PUBLIC_STT_BACKEND=browser_speech

# Tahap 2+ (isi sendiri saat tahap terkait):
# Tahap 2: aktifkan (hapus tanda #) saat siap. APIKEY dan MODEL diisi sendiri.
# NEXT_PUBLIC_OPENAI_URL=https://generativelanguage.googleapis.com
# NEXT_PUBLIC_OPENAI_CHAT_PATH=/v1beta/openai/chat/completions
# NEXT_PUBLIC_OPENAI_APIKEY=
# NEXT_PUBLIC_OPENAI_MODEL=
# NEXT_PUBLIC_OPENAI_MAX_TOKENS=300
# Opsional: kosongkan jika model menolak parameter ini.
# NEXT_PUBLIC_OPENAI_REASONING_EFFORT=none

# LLM cadangan (opsional tapi disarankan): dipakai otomatis jika LLM utama gagal
# (mis. HTTP 503) atau belum menjawab setelah HEDGE_MS milidetik. Contoh Groq
# (format OpenAI). Jalankan `npm run nara:models -- fallback` untuk daftar model.
# NEXT_PUBLIC_OPENAI_FALLBACK_URL=https://api.groq.com
# NEXT_PUBLIC_OPENAI_FALLBACK_PATH=/openai/v1/chat/completions
# NEXT_PUBLIC_OPENAI_FALLBACK_APIKEY=
# NEXT_PUBLIC_OPENAI_FALLBACK_MODEL=
# NEXT_PUBLIC_OPENAI_FALLBACK_REASONING_EFFORT=
# NEXT_PUBLIC_OPENAI_HEDGE_MS=1500

# Tahap 3 (TTS cadangan mode 3D VRM: Edge TTS id-ID-GadisNeural):
NEXT_PUBLIC_EDGE_TTS_URL=/tts
NEXT_PUBLIC_EDGE_TTS_VOICE=id-ID-GadisNeural
# Opsional jika memakai server lokal openai-edge-tts:
# NEXT_PUBLIC_OPENAI_TTS_URL=http://localhost:5050
# NEXT_PUBLIC_OPENAI_TTS_APIKEY=
# NEXT_PUBLIC_OPENAI_TTS_VOICE=id-ID-GadisNeural

# Tahap 4 (STT cadangan Groq Whisper untuk ruangan ramai):
# NEXT_PUBLIC_OPENAI_WHISPER_URL=https://api.groq.com/openai
# NEXT_PUBLIC_OPENAI_WHISPER_APIKEY=
# NEXT_PUBLIC_OPENAI_WHISPER_MODEL=whisper-large-v3-turbo
NEXT_PUBLIC_OPENAI_WHISPER_LANGUAGE=id

