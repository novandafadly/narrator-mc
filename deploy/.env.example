# Salin ke deploy/.env di SERVER, lalu isi. File .env tidak boleh di-commit
# (sudah di .gitignore dan .dockerignore).

# --- Alamat situs dan HTTPS ---
# Domain Anda, atau <ip-dengan-strip>.sslip.io (mis. 129-146-1-2.sslip.io).
SITE_ADDRESS=
# Email untuk sertifikat HTTPS Let's Encrypt (wajib).
ACME_EMAIL=

# --- Password halaman (Basic Auth) ---
BASIC_USER=nara
# Hash bcrypt, bukan password asli. Buat dengan:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'PASSWORD_ANDA'
# Tulis di dalam tanda kutip TUNGGAL agar karakter $ tidak diubah.
BASIC_HASH=''

# --- Token API (menjaga /llm, /llm2, /stt) ---
# String acak panjang. Buat dengan:  openssl rand -hex 24
# Tertanam di halaman (yang hanya bisa dibuka setelah login). Ganti jika bocor.
PROXY_TOKEN=

# --- API key asli: hanya di server ini ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Model (tertanam saat build: ubah lalu jalankan `docker compose up -d --build`) ---
LLM_MODEL=gemini-3.1-flash-lite
# Kosongkan FALLBACK_MODEL jika tidak memakai cadangan.
FALLBACK_MODEL=
FALLBACK_REASONING_EFFORT=low
MAX_TOKENS=1024
HEDGE_MS=1500
